# PITSTOP POS backend — environment template
# Copy to `backend/.env` (or export these in the environment) and edit.

# application
APP_NAME=PITSTOP POS
APP_ENV=development            # development | production
LOG_LEVEL=INFO

# database (asyncpg URI). For hosted Postgres use ?ssl=require (asyncpg reads
# `ssl`, NOT `sslmode`). Percent-encode any `@ : / % # ?` inside the password.
DATABASE_URL=postgresql+asyncpg://pitstop:pitstop_dev_password@localhost:5432/pitstop_dev
# Supabase example (session pooler on port 5432; port 6543 breaks asyncpg):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<urlencoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

# auth
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# security / behavior
CORS_ORIGINS=["http://localhost:5173"]   # JSON array or comma-separated list
TAX_RATE_PERCENT=8.00                    # retail SST applied server-side
LOGIN_RATE_LIMIT=10/minute

# docs (OpenAPI). Lock down in production: EXPOSE_DOCS=false
EXPOSE_DOCS=true
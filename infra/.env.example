# infra/.env — docker compose variables (copy this file to infra/.env)
# Required so the container never runs with an insecure signing secret.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional overrides
POSTGRES_PASSWORD=pitstop_dev_password
CORS_ORIGINS=["http://localhost:8080"]
TAX_RATE_PERCENT=8.00
LOGIN_RATE_LIMIT=10/minute
EXPOSE_DOCS=false